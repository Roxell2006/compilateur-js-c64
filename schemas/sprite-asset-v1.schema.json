{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://js-c64.dev/schemas/sprite-asset-v1.schema.json",
  "title": "js-c64 sprite asset v1",
  "type": "object",
  "required": ["version", "id", "mode", "frames"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "maxLength": 64 },
    "mode": { "enum": ["hires", "multicolor"] },
    "color": { "type": "integer", "minimum": 0, "maximum": 15, "default": 1 },
    "multicolor1": { "type": "integer", "minimum": 0, "maximum": 15 },
    "multicolor2": { "type": "integer", "minimum": 0, "maximum": 15 },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": { "type": "integer", "minimum": 0, "maximum": 23, "default": 0 },
        "y": { "type": "integer", "minimum": 0, "maximum": 20, "default": 0 }
      }
    },
    "hitbox": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offsetX": { "type": "integer", "minimum": 0, "maximum": 23, "default": 0 },
        "offsetY": { "type": "integer", "minimum": 0, "maximum": 20, "default": 0 },
        "width": { "type": "integer", "minimum": 1, "maximum": 24, "default": 24 },
        "height": { "type": "integer", "minimum": 1, "maximum": 21, "default": 21 }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": ["id", "data"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$", "maxLength": 64 },
          "data": {
            "type": "array",
            "minItems": 63,
            "maxItems": 63,
            "items": { "type": "integer", "minimum": 0, "maximum": 255 }
          }
        }
      }
    },
    "animations": {
      "type": "object",
      "default": {},
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$", "maxLength": 64 },
      "additionalProperties": {
        "type": "object",
        "required": ["frames"],
        "additionalProperties": false,
        "properties": {
          "frames": {
            "type": "array",
            "minItems": 1,
            "maxItems": 255,
            "items": {
              "oneOf": [
                { "type": "integer", "minimum": 0, "maximum": 127 },
                { "type": "string", "minLength": 1, "maxLength": 64 }
              ]
            }
          },
          "speed": { "type": "integer", "minimum": 1, "maximum": 255, "default": 6 },
          "loop": { "type": "boolean", "default": true }
        }
      }
    },
    "initialAnimation": { "type": "string", "minLength": 1, "maxLength": 64 }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "multicolor" } } },
      "then": { "required": ["multicolor1", "multicolor2"] }
    }
  ]
}
