{
  "name": "js-c64",
  "version": "1.0.0",
  "description": "JavaScript DSL and mini game engine that emits Commodore 64 6502 programs, assets and D64 disks.",
  "type": "module",
  "bin": {
    "c64js": "./src/cli.js"
  },
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": "./src/index.js",
    "./assembler": "./src/assembler6502.js",
    "./compiler": "./src/compiler.js",
    "./assets": "./src/assets.js",
    "./d64": "./src/d64Writer.js",
    "./irq/raster": "./src/irq/raster.js"
  },
  "files": [
    "src",
    "schemas",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "RELEASE_CHECKLIST.md",
    "release-budgets.json",
    "MODE_EMPLOI_DEBUTANT.txt",
    "MODE_EMPLOI_PUBLICATION_NPM.txt",
    "index.d.ts"
  ],
  "scripts": {
    "build:hello": "node src/cli.js build examples/hello.js -o dist/hello.prg",
    "build:raster": "node src/cli.js build examples/raster-bars.js -o dist/raster-bars.prg",
    "build:raster-ready": "node src/cli.js build examples/raster-ready-border-cycle.js -o dist/raster-ready-border-cycle.prg",
    "build:demos": "node scripts/build-examples.js",
    "build:release": "node scripts/build-release.js",
    "release:check": "node scripts/release-check.js",
    "test": "vitest run",
    "prepublishOnly": "npm run release:check"
  },
  "keywords": [
    "commodore64",
    "c64",
    "6502",
    "assembler",
    "retro",
    "dsl",
    "javascript"
  ],
  "author": "Roxell2006",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Roxell2006/compilateur-js-c64.git"
  },
  "bugs": {
    "url": "https://github.com/Roxell2006/compilateur-js-c64/issues"
  },
  "homepage": "https://github.com/Roxell2006/compilateur-js-c64#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
